source "https://rubygems.org"

# GitHub Pages builds the site with this gem set server-side; it pins Jekyll and
# the supported plugin versions. Local preview: `bundle install && bundle exec jekyll serve`.
gem "github-pages", group: :jekyll_plugins

gem "jekyll-feed"
gem "jekyll-seo-tag"
gem "jekyll-sitemap"

# Ruby 3.4+ dropped these from the default gems; Jekyll still needs them.
gem "webrick", "~> 1.8"
gem "csv"
gem "base64"
gem "bigdecimal"
